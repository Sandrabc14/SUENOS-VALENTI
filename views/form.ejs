<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suscripción | Sueños Valenti</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="oscuro">
    <div class="stars"></div>

    <nav>
        <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary); text-shadow: var(--neon-glow);"><a href="/" style="color:inherit;">✨ Sueños Valenti</a></div>
        <ul class="nav-links">
            <li><a href="/">Inicio</a></li>
            <li><button id="theme-toggle" aria-label="Cambiar tema">☀️</button></li>
        </ul>
    </nav>

    <main class="center-screen">
        <div class="glass-card" style="max-width: 550px;">
            <h2>Únete al Círculo</h2>
            
            <% if (typeof errores !== "undefined" && errores.length) { %>
                <div class="error-msg">
                    <p><strong>El universo nos indica que hay correcciones:</strong></p>
                    <ul style="margin-left: 1.5rem; margin-top: 0.5rem;">
                        <% errores.forEach((e) => { %>
                            <li><%= e %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form action="/form" method="POST">
                <div class="form-group">
                    <label>Tu Nombre Terrenal</label>
                    <input type="text" name="nombre" value="<%= nombre || '' %>" required placeholder="Cómo te llaman en este plano" /> 
                </div>

                <div class="form-group">
                    <label>Correo Electrónico</label>
                    <input type="email" name="email" value="<%= email || '' %>" required placeholder="Para enviarte energía (y correos)" /> 
                </div>

                <div style="display: flex; gap: 1rem;">
                    <div class="form-group" style="flex: 1;">
                        <label>Vueltas al Sol (Edad)</label>
                        <input type="number" name="edad" min="0" value="<%= edad || '' %>" placeholder="Años" />
                    </div>

                    <div class="form-group" style="flex: 2;">
                        <label>Refugio Actual (Ciudad)</label>
                        <select name="ciudad">
                            <option value="">-- Selecciona un punto focal --</option>
                            <option value="Madrid" <%= typeof ciudad !== 'undefined' && ciudad === 'Madrid' ? 'selected' : '' %>>Madrid</option> 
                            <option value="Alicante" <%= typeof ciudad !== 'undefined' && ciudad === 'Alicante' ? 'selected' : '' %>>Alicante</option>
                            <option value="Murcia" <%= typeof ciudad !== 'undefined' && ciudad === 'Murcia' ? 'selected' : '' %>>Murcia</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label style="margin-bottom: 1rem;">¿Qué energías buscas manifestar?</label>
                    <div class="radio-group">
                        <label>
                            <input type="checkbox" name="intereses" value="Meditacion" <%= (typeof intereses !== 'undefined' && (intereses || []).includes('Meditacion')) ? 'checked' : '' %> />
                            🧘‍♀️ Meditación Profunda
                        </label>
                        <label>
                            <input type="checkbox" name="intereses" value="Naturaleza" <%= (typeof intereses !== 'undefined' && (intereses || []).includes('Naturaleza')) ? 'checked' : '' %> />
                            🌿 Conexión Natural
                        </label>
                        <label>
                            <input type="checkbox" name="intereses" value="Manifestacion" <%= (typeof intereses !== 'undefined' && (intereses || []).includes('Manifestacion')) ? 'checked' : '' %> />
                            ✨ Manifestación de Deseos
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn mt-2">Sellar Suscripción</button>
            </form>
        </div>
    </main>

    <script src="/script.js"></script>
</body>
</html>
